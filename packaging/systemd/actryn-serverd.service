[Unit]
Description=Actryn authenticated attempt and model broker
Wants=actryn-launcher.service
After=actryn-launcher.service systemd-tmpfiles-setup.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30
# Installer pins this sysusers-allocated UID as server_uid in the protected configuration.
User=actryn-server
Group=actryn-server
ExecStart=/usr/bin/actryn-serverd
ExecStopPost=/usr/bin/actryn-serverd --recover-only
Restart=on-failure
RestartSec=1
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ReadWritePaths=/var/lib/actryn-server/broker /run/actryn/brokers /run/actryn-server
InaccessiblePaths=/run/containerd -/etc/actryn/credentials
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
TasksMax=64
MemoryMax=256M
LimitNOFILE=256
# Live inference is opt-in via an operator-installed drop-in using LoadCredential=
# openai-api-key:/etc/actryn/credentials/openai-api-key. No credential is needed offline.

[Install]
WantedBy=multi-user.target
